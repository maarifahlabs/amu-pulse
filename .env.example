# Copy to .env.local and fill in. Without the Supabase values the app runs in
# read-only demo mode using clearly labeled sample data.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production on the subdomain. Leave both of the following empty:
# the app is served at the subdomain root, and the company homepage stays separate.
# NEXT_PUBLIC_SITE_URL=https://amu-pulse.maarifahlabs.com
NEXT_PUBLIC_BASE_PATH=
LEGACY_SITE_ORIGIN=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Claim notifications. Resend sends the candidate's details to the review inbox.
RESEND_API_KEY=
CLAIM_NOTIFY_EMAIL=
CLAIM_NOTIFY_FROM=
