# Copy to .env.local and fill in. Without the Supabase values the app runs in
# read-only demo mode using clearly labeled sample data.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production on maarifahlabs.com:
# NEXT_PUBLIC_SITE_URL=https://maarifahlabs.com
# NEXT_PUBLIC_BASE_PATH=/amu-pulse
# LEGACY_SITE_ORIGIN=https://maarifahlabs.github.io
NEXT_PUBLIC_BASE_PATH=
LEGACY_SITE_ORIGIN=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
