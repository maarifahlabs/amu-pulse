# Copy to .env.local and fill in.

VITE_SITE_URL=http://localhost:5173
# Production: VITE_SITE_URL=https://amupulse.maarifahlabs.com

# Base URL of the AMU Pulse API (the amu-pulse-api NestJS project).
VITE_API_URL=http://localhost:3000

# Razorpay Key Id (rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID=
VITE_UPI_ID=amupulse@upi
VITE_UPI_PAYEE="AMU Pulse Elections"
